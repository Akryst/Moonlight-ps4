# Build (CMake / Ninja)
/build/
/build-*/
/dist/
.cache/
compile_commands.json

# Failed patch leftovers (third_party trees stay dirty after apply_patches — do not commit them)
*.rej
*.orig

# PS4 build / packaging artifacts
*.pkg
*.elf
*.oelf
*.self
*.o
*.a
eboot.bin
pkg.gp4
pkg-stage/
moonlight-cli

# GoldHEN plugin build outputs (rebuild: make -C plugin/…)
plugin/bin/

# Local config / identity (do not commit)
debug_host.txt
host.txt
pin.txt
/certs/
*.pem
*.crt
*.key

# Console dumps / logs (FTP /data/moonlight/) — never ship these in the .pkg
*.log
vo_diag*.txt
kernel_*.bin
pkg/assets/misc/*
!pkg/assets/misc/moonlight.ini
pkg/assets/misc/moonlight/

# IDE / editor / OS
.vscode/
.idea/
.cursor/
*.swp
*~
.DS_Store
Thumbs.db
/tools/
__pycache__/

# Local testing: suites, fixtures, temporary runs and reports
/tests/
/testing/
/test-results/
/test-reports/
/coverage/
/htmlcov/
/artifacts/testing/
**/test_*.c
**/test_*.cpp
**/test_*.py
**/*_test.c
**/*_test.cpp
**/*_test.py
.pytest_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
junit*.xml
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
*.asan
*.ubsan
